# Hostinger: real accounts and email, Stripe TEST payments only.
NODE_ENV=production
PLATFORM_MODE=live
SITE_URL=https://REEMPLAZAR-POR-DOMINIO-TEMPORAL
# Let Hostinger provide PORT. No FIRESTORE_EMULATOR_HOST in live mode.
FIREBASE_PROJECT_ID=viicasa
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=viicasa.firebaseapp.com
FIREBASE_WEB_APP_ID=1:159084480889:web:f193adc5bcde06897fc7a8
# Paste the private service-account JSON ONLY into the hosting secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_EMAILS=viicasa.database@gmail.com
PAYMENT_PROVIDER=stripe
STRIPE_MODE=test
# Configure these secrets in Hostinger; never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
COMMERCE_ENABLED=true
# Keep the existing approved value in Hostinger. This template does not approve legal terms.
PRIVACY_APPROVED=false
MAIL_MODE=smtp
# Real ViiLife order flow in CAD, including approval for large orders.
# This section flag never changes the payment mode of other services.
VIILIFE_MODE=live
# Legacy local-only demos stay isolated. This flag is not used by the live flow.
VIILIFE_DEMO_MAIL_MODE=outbox
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=accounts@viicasa.com
SMTP_PASSWORD=
MAIL_FROM=accounts@viicasa.com
ADMIN_EMAIL=gerson@novaweb-agency.com
# Replace with a persistent private directory confirmed by Hostinger.
MEDIA_DIR=./data/media
# Exact proxy addresses confirmed by the provider, not * or browser country headers.
TRUSTED_PROXY_IPS=
AUTH_APPLE_ENABLED=false
AUTH_EMAIL_ENABLED=false
