# TEMPLATE ONLY. Do not replace the working Firebase/SMTP/Stripe environment.
# PostgreSQL is NOT used by server.js yet; commercial activation is a later release.
PHASE2_MODE=staging
PHASE2_DATABASE_DRIVER=postgres
PHASE2_DATABASE_SSL=true
# Create TWO distinct empty databases, with certificate-verified TLS.
PHASE2_COMMERCIAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/COMMERCIAL_DATABASE
PHASE2_PLATFORM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/PLATFORM_DATABASE
PHASE2_SITE_URL=https://YOUR-STAGING-DOMAIN
# Set a private encryption key according to phase2/security.mjs before activation.
# Never reuse the source demo credentials or seed examples into staging.
