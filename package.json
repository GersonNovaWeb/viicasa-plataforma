{
  "name": "viicasa-plataforma",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node viicasa-frontend-prototype/dev-local.mjs",
    "build": "node scripts/check.mjs && node viicasa-backend/scripts/geoip.mjs",
    "check": "node scripts/check.mjs",
    "preflight:auth": "node --env-file-if-exists=.env viicasa-frontend-prototype/preflight.mjs",
    "preflight:payments": "node --env-file-if-exists=.env viicasa-frontend-prototype/preflight.mjs --payments",
    "test:platform": "node --test viicasa-frontend-prototype/test/platform.test.mjs viicasa-frontend-prototype/test/currency.test.mjs",
    "test:registration": "node --test viicasa-backend/test/customer-registration.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.1",
    "file-type": "^22.0.2",
    "firebase-admin": "^14.3.0",
    "ip-location-api": "5.0.2",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "stripe": "^22.6.1"
  },
  "devDependencies": {"firebase-tools": "^15.29.0"}
}
