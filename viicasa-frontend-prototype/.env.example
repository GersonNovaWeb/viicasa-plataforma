# LOCAL DEMO. The server binds only 127.0.0.1 in this mode.
PLATFORM_MODE=demo
SITE_URL=http://127.0.0.1:3015
PORT=3015
# For live deployment: PLATFORM_MODE=live, NODE_ENV=production, HTTPS SITE_URL.
# No demo catalog/admin shortcut is created in live mode.
FIREBASE_PROJECT_ID=viicasa
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=viicasa.firebaseapp.com
FIREBASE_WEB_APP_ID=
ADMIN_EMAILS=viicasa.database@gmail.com
# Do not enable public operations until privacy/terms have been approved.
COMMERCE_ENABLED=false
PRIVACY_APPROVED=false
# Live payments stay disabled until Stripe TEST credentials + webhook are tested.
PAYMENT_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAIL_MODE=outbox
MAIL_FROM=
ADMIN_EMAIL=viicasa.database@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Must be a persistent, private server directory; images are served through API.
MEDIA_DIR=./data/media
# Exact reverse-proxy IP addresses confirmed by the hosting provider, comma separated.
# Leave empty in local development. Never trust all IPs or browser country headers.
TRUSTED_PROXY_IPS=
