NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Desarrollo seguro: solo emulador local; sin credenciales de Google.
DATABASE_DRIVER=firestore
FIREBASE_MODE=emulator
FIREBASE_PROJECT_ID=demo-viicasa
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_BUCKET=viicasa.firebasestorage.app
MEDIA_DIR=./data/media
PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ADMIN_EMAIL=administracion@example.com
# demo solo funciona fuera de produccion. disabled bloquea nuevos cobros.
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VIICASA <no-reply@example.com>
HOLD_MINUTES=30
SESSION_HOURS=8
TRUST_PROXY=false
